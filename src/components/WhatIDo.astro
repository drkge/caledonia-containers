---
import { getCollection } from "astro:content";
const posts = (await getCollection("service")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
import { Icon } from "astro-icon/components";

const bgClasses = [
  "bg-pgreen rounded-full",
  "bg-pblue rounded-2xl",
  "bg-ppink ",
  "bg-pyellow rounded-md",
];

const getRandomClass = () => {
  return bgClasses[Math.floor(Math.random() * bgClasses.length)];
};
---

<section class="flex flex-col text-center gap-6">

  <div>
    <h1 class="text-3xl md:text-6xl font-semibold text-shadow text-center">
      <span class="font-kablamo text-pblue">H</span>ow we can help you</h1>
  </div>


  <p class="text-pblack">Our comprehensive suite of skip professional services caters to a diverse clientele, ranging from homeowners to commercial developers.</p>
  <div class="flex flex-wrap justify-center gap-6">
    {
      posts.map((post) => {
        const randomClass = getRandomClass();
        return (
          <a href={`/services/${post.id}/`} class="w-72 text-left rounded-3xl border-1 border-black shadow-card group hover:shadow-hover transition  px-4 py-6 flex flex-col gap-6">
            <div class="flex flex-col gap-4">
              <div
                class={`${randomClass} text-4xl p-2 self-start border-1 border-black shadow-card1 group-hover:shadow-card transition`}
              >
                <Icon name={post.data.icon} />
              </div>
              <h4 class="text-xl font-semibold">{post.data.title}</h4>
            </div>
            <div set:html={post.data.description} />
          </a>
        );
      })
    }
  </div>
</section>
