---
import Link from "./HeaderLink.astro";
import "../styles/hamburgers.css";
import Contact from "./Contact.astro";
---

<header>
  <nav class="flex container mx-auto p-6 items-center justify-center h-20">
    <!-- MOBILE NAVIGATION -->
    <div class="md:hidden z-40">
      <div class="fixed top-0 left-0 right-0 z-50 w-full flex justify-center">
        <button
          class="hamburger hamburger--elastic"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="navigation"
        >
          <span class="hamburger-box">
            <span class="hamburger-inner"></span>
          </span>
        </button>
      </div>

      <div
        id="navigation"
        class="fixed top-0 left-0 right-0 w-full h-full bg-white transform -translate-y-full transition-transform duration-300 ease-in-out"
      >
        <ul
          class="flex flex-col items-center justify-center h-full gap-4 text-nowrap"
        >
          <li><Link href="/" text="Home" style="primary" /></li>
          <li><Link href="/about/" text="Our Journey" style="secondary" /></li>
          <li>
            <Link href="/services/" text="Our Services" style="tertiary" />
          </li>
          <li>
            <Link href="/contact/" text="Contact Us" style="primary" />
          </li>
          <li>
            <Link
              href="https://skipbits.co.uk"
              text="Skip Parts"
              style="secondary"
            />
          </li>

          <Contact />
        </ul>
      </div>
    </div>

    <!-- DESKTOP NAVIGATION -->
    <ul class="items-center text-nowrap hidden md:flex">
      <li>
        <Link href="/" text="Home" style="primary" />
        <li><Link href="/about/" text="Our Journey" style="secondary" /></li>
        <li><Link href="/services/" text="Our Services" style="tertiary" /></li>
        <li><Link href="/contact/" text="Contact" style="primary" /></li>
        <li>
          <Link
            href="https://skipbits.co.uk"
            text="Skip Parts"
            style="secondary"
          />
        </li>
      </li>
    </ul>
  </nav>
  <script is:inline>
    function init() {
      const hamburger = document.querySelector(".hamburger");
      const menu = document.getElementById("navigation");

      if (hamburger && menu) {
        hamburger.addEventListener("click", () => {
          const open = hamburger.classList.toggle("is-active");
          menu.classList.toggle("-translate-y-full");
          menu.classList.toggle("translate-y-0");
          hamburger.setAttribute("aria-expanded", String(open));
          hamburger.setAttribute(
            "aria-label",
            open ? "Close navigation menu" : "Open navigation menu"
          );
        });
      }
    }
    init();
    document.addEventListener("astro:after-swap", init);
  </script>
</header>
