---
import type { HTMLAttributes } from "astro/types";

type Type = "primary" | "secondary" | "tertiary";
const {
  href = "",
  text = "",
  style = "primary",
  class: className,
  ...props
} = Astro.props;

interface Props extends HTMLAttributes<"a"> {
  text: string;
  href: string;
  style: Type;
}

const types: Record<Type, string> = {
  primary: "hover:shadow-predHover",
  secondary: "hover:shadow-pyellowHover",
  tertiary: "hover:shadow-pblackHover",
};

const getType = (style: Type) => {
  return types[style] || "";
};

// Paths are emitted with a trailing slash, so strip it before comparing.
const trim = (path: string) => (path.length > 1 ? path.replace(/\/+$/, "") : path);
const pathname = trim(
  Astro.url.pathname.replace(import.meta.env.BASE_URL, "")
);
const target = trim(href);
const subpath = pathname.match(/[^\/]+/g);
const isActive = target === pathname || target === "/" + (subpath?.[0] || "");
---

<a
  href={href}
  class:list={[
    className,
    `rounded-md border-black inline-block px-5 py-2 hover:border-1 ${getType(style)} transition ease-in-out`,
    { active: isActive },
  ]}
  {...props}
>
  {text}
</a>

<style>
  a {
    display: inline-block;
    text-decoration: none;
  }
  a.active {
    font-weight: bolder;
  }
</style>
