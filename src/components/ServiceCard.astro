---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  service: CollectionEntry<"service">;
}
const { service } = Astro.props;
const { title, description, heroImage, heroAlt } = service.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-lg border border-steel-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-steel-300 hover:shadow-xl focus-within:-translate-y-1 focus-within:shadow-xl">
  <div class="aspect-[4/3] overflow-hidden bg-steel-100">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-2xl font-bold tracking-tight text-steel-950 uppercase">
      <!-- Stretched link: the whole card is clickable, but its name is just the title. -->
      <a href={`/services/${service.id}/`} class="after:absolute after:inset-0 focus-visible:outline-none">
        {title}
      </a>
    </h3>
    <p class="mt-2 leading-relaxed text-steel-600">{description}</p>
    <p class="mt-auto inline-flex items-center gap-2 pt-6 font-semibold text-brand-600" aria-hidden="true">
      Learn more
      <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
    </p>
  </div>
</article>
