---
import LogoMark from "./LogoMark.astro";

interface Props {
  /** "dark" text for light backgrounds, "light" text for dark ones. */
  tone?: "dark" | "light";
}
const { tone = "dark" } = Astro.props;
---

<a
  href="/"
  class="group inline-flex shrink-0 items-center gap-3"
  aria-label="Caledonia Containers — home"
>
  <LogoMark class="size-10 transition-transform duration-200 group-hover:-rotate-3" />
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        "font-display text-[1.4rem] font-bold tracking-[0.06em] uppercase",
        tone === "dark" ? "text-steel-950" : "text-white",
      ]}>Caledonia</span
    >
    <span
      class:list={[
        "mt-0.5 text-[0.62rem] font-semibold tracking-[0.36em] uppercase",
        tone === "dark" ? "text-steel-500" : "text-steel-400",
      ]}>Containers</span
    >
  </span>
</a>
