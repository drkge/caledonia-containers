---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE } from "@/consts";

type Props = CollectionEntry<"service">["data"] & {
  /** Overrides the <title> without touching the visible <h1>. */
  seoTitle?: string;
  /** Overrides the meta description without touching the visible copy. */
  seoDescription?: string;
  schema?: Record<string, any>[];
};

const {
  title = "",
  description,
  seoTitle,
  seoDescription,
  schema = [],
} = Astro.props;

import { getCollection } from "astro:content";
const posts = (await getCollection("service")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Home > (Our Services) > This page
const isService = Astro.url.pathname.startsWith("/services/");
const trail = [
  { name: "Home", path: "/" },
  ...(isService ? [{ name: "Our Services", path: "/services/" }] : []),
  { name: title, path: Astro.url.pathname },
];

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: trail.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.path, Astro.site).href,
  })),
};

const bgClasses = [
  "hover:shadow-predHover",
  "hover:shadow-pyellowHover",
  "hover:shadow-pblackHover",
];
const getRandomClass = () => {
  return bgClasses[Math.floor(Math.random() * bgClasses.length)];
};
---

<html lang="en-GB">
  <head>
    <BaseHead
      title={seoTitle ?? title}
      description={seoDescription ?? description}
      schema={[breadcrumbs, ...schema]}
    />
  </head>
  <body>
    <Header />
    <main class="container mx-auto md:px-10 py-20">
      <article>
        <div>
          <div>
            <h1
              class="text-3xl md:text-6xl font-semibold text-shadow text-center"
            >
              <span
                class="font-kablamo text-[#E63D24] hover:text-yellow-400 transition-all ease-in-out duration-200"
                >{title.charAt(0)}</span
              >{title.slice(1)}
            </h1>
          </div>
        </div>
        <div class="text-black px-6 md:px-0">
          <div
            class="flex gap-4 md:gap-6 py-10 md:flex-row flex-col justify-between"
          >
            <div class="prose md:w-2/3 flex flex-col gap-6">
              <slot />
            </div>

            <nav
              class="flex flex-col gap-6"
              transition:animate="slide"
              aria-label="Our services"
            >
              <ul
                class="flex flex-col gap-2 pt-10 md:pt-0 items-start md:items-end"
              >
                {
                  posts.map((post) => {
                    return (
                      <li
                        class={`text-left rounded-lg border-1 border-black shadow-card group hover:shadow-hover transition  px-2 py-2 ${getRandomClass()}`}
                      >
                        <a href={`/services/${post.id}/`}>
                          <h4>{post.data.title}</h4>
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
              <hr />
            </nav>
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
