---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import Capabilities from "@/components/Capabilities.astro";
import Process from "@/components/Process.astro";
import CtaBand from "@/components/CtaBand.astro";
import { SITE_DESCRIPTION, SHOPS } from "@/consts";

import workshopImage from "@/assets/rollon-2.webp";
import paintImage from "@/assets/refurb-4.webp";
import aboutImage from "@/assets/about-3.webp";
import skipbitsLogo from "@/assets/skipbits.png";
import dustybinsLogo from "@/assets/dustybins.webp";

const logos: Record<string, ImageMetadata> = {
  "skipbits.png": skipbitsLogo,
  "dustybins.webp": dustybinsLogo,
};

const services = (await getCollection("service")).sort((a, b) => a.data.order - b.data.order);

const strengths = [
  { icon: "lucide:layers", title: "Builders' skips to RoRo", text: "Every kind of skip and waste container" },
  { icon: "lucide:spray-can", title: "Blast & paint in-house", text: "Shot blasting, spray painting and graphics" },
  { icon: "lucide:repeat", title: "Part exchange", text: "Trade in worn containers against new" },
  { icon: "lucide:package", title: "Spare parts", text: "Order direct from our Skip Bits shop" },
];
---

<BaseLayout title="Caledonia Containers | Skip Manufacturer & Repairs, Ayrshire" description={SITE_DESCRIPTION}>
  <Hero />

  <!-- Strengths strip -->
  <section aria-label="Why Caledonia Containers" class="border-b border-steel-200 bg-white">
    <ul class="wrap grid divide-steel-200 sm:grid-cols-2 xl:grid-cols-4 xl:divide-x">
      {
        strengths.map((s) => (
          <li class="flex items-center gap-4 py-6 xl:px-7 xl:py-7 xl:first:pl-0">
            <Icon name={s.icon} class="size-8 shrink-0 text-brand-500" />
            <span>
              <span class="block font-display text-lg leading-tight font-bold tracking-wide text-steel-950 uppercase">{s.title}</span>
              <span class="block text-sm text-steel-600">{s.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Services -->
  <section class="bg-steel-50 py-20 sm:py-24" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="services-heading"
          eyebrow="What we do"
          title="Skips and containers, built and rebuilt"
          lead="From a single builders' skip to a fleet of roll-on roll-off containers, we build, repair and refurbish the equipment your business depends on."
        />
        <a href="/services/" class="btn btn-outline shrink-0 self-start lg:self-auto">
          All services
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <!-- Workshop -->
  <section class="py-20 sm:py-24" aria-labelledby="workshop-heading">
    <div class="wrap">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div class="relative pr-6 pb-10 sm:pr-14">
          <Image
            src={workshopImage}
            alt="A roll-on roll-off container stripped back to bare steel in the workshop"
            widths={[640, 960, 1200]}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="aspect-[4/3] w-full rounded-lg object-cover"
          />
          <Image
            src={paintImage}
            alt="Close-up of a container's freshly resprayed green paintwork"
            widths={[320, 480]}
            sizes="(min-width: 640px) 190px, 38vw"
            class="absolute right-0 bottom-0 aspect-square w-[38%] rounded-lg border-[6px] border-white object-cover shadow-xl sm:w-[190px]"
          />
        </div>
        <div>
          <SectionHeading
            id="workshop-heading"
            eyebrow="Our workshop"
            title="A one-stop shop for all your metalwork"
            lead="Fabrication, shot blasting, welding, repairs, refurbishment, sales and spare parts — all under one roof, so your containers aren't passed from one supplier to the next."
          />
          <div class="mt-8 flex gap-4 rounded-lg border-l-4 border-brand-500 bg-steel-50 p-5">
            <Icon name="lucide:truck" class="mt-0.5 size-6 shrink-0 text-steel-900" />
            <p class="text-steel-700">
              <strong class="font-semibold text-steel-950">Beyond skips:</strong> we also spray paint,
              modify and convert trucks, trailers, waste recycling plant and agricultural equipment.
            </p>
          </div>
        </div>
      </div>
      <div class="mt-16 border-t border-steel-200 pt-14">
        <Capabilities columns={4} />
      </div>
    </div>
  </section>

  <Process />

  <!-- About -->
  <section class="py-20 sm:py-24" aria-labelledby="about-heading">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2">
      <div>
        <SectionHeading
          id="about-heading"
          eyebrow="About us"
          title="Built for Scotland's waste and recycling industry"
        />
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-steel-600">
          <p>
            Service, manufacturing and spare-parts support for Scottish waste carriers was hard to
            come by — so we set up a dedicated operation to provide it.
          </p>
          <p>
            Our experienced team manufactures, refurbishes and repairs every type of skip and
            waste container, from the smallest builders' skips to the largest roll-on roll-off
            compactors.
          </p>
        </div>
        <a href="/about/" class="mt-8 inline-flex items-center gap-2 font-semibold text-brand-600 hover:text-brand-700">
          Read our story
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </div>
      <Image
        src={aboutImage}
        alt="A freshly painted red builders' skip in the yard"
        widths={[640, 960, 1200]}
        sizes="(min-width: 1024px) 560px, 100vw"
        class="aspect-[4/3] w-full rounded-lg object-cover"
      />
    </div>
  </section>

  <!-- Online shops -->
  <section class="border-t border-steel-200 bg-steel-50 py-20" aria-labelledby="shops-heading">
    <div class="wrap">
      <SectionHeading id="shops-heading" eyebrow="Shop online" title="Parts and bins, delivered" />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          SHOPS.map((shop) => (
            <a
              href={shop.href}
              class="group flex items-center gap-6 rounded-lg border border-steel-200 bg-white p-6 transition hover:border-steel-300 hover:shadow-lg"
            >
              <Image src={logos[shop.logo]} alt="" width={96} height={96} class="size-20 shrink-0 rounded-md object-contain" />
              <span class="flex-1">
                <span class="flex items-center gap-2 font-display text-2xl font-bold tracking-tight text-steel-950 uppercase">
                  {shop.name}
                  <Icon name="lucide:arrow-up-right" class="size-5 text-steel-400 transition group-hover:text-brand-600" />
                </span>
                <span class="mt-1 block text-steel-600">{shop.blurb}</span>
                {shop.note && <span class="mt-2 block text-sm font-semibold text-steel-500">{shop.note}</span>}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
