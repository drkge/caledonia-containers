---
import Layout from '@/layouts/ServicePost.astro';
import { SITE_URL, BUSINESS, OG_IMAGE } from '@/consts';

const tags = ['skips', 'skip refurbishment', 'part exchange', 'sheeting systems', 'new skips', 'skip parts', 'roll-on roll-on skips', 'wheelie bins', 'containers', 'new containers', 'container refurbishment' ];
const description = "Get in touch with us";
const seoTitle = 'Contact Us';
const seoDescription =
	`Call ${BUSINESS.telephone} or find us at Caledonia Containers Ltd, 3 Irvine Road, Lugton Bridge, Lugton, Ayrshire KA3 4ED. Skip manufacturing and repairs, Scotland.`;

const localBusiness = {
	'@type': 'LocalBusiness',
	'@id': `${SITE_URL}/#localbusiness`,
	name: BUSINESS.legalName,
	description: seoDescription,
	url: `${SITE_URL}/`,
	image: `${SITE_URL}${OG_IMAGE.src}`,
	email: BUSINESS.email,
	telephone: BUSINESS.telephoneIntl,
	parentOrganization: { '@id': `${SITE_URL}/#organization` },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.address.street,
		addressLocality: BUSINESS.address.locality,
		addressRegion: BUSINESS.address.region,
		postalCode: BUSINESS.address.postalCode,
		addressCountry: BUSINESS.address.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.latitude,
		longitude: BUSINESS.geo.longitude,
	},
	areaServed: BUSINESS.areaServed.map((name) => ({
		'@type': 'AdministrativeArea',
		name,
	})),
};
---

<Layout
	tags={tags}
	icon="beach"
	title="Get In Touch"
	description= {description}
	seoTitle={seoTitle}
	seoDescription={seoDescription}
	schema={[localBusiness]}
	pubDate={new Date('August 08 2021')}
>
<h3>Caledonia Containers</h3>
<p>Caledonia Containers Ltd.</p>


<div class="flex flex-col gap-1">
	<h4>Contact Information</h4>
	<div>
		<span>Telephone:</span>
		<span><a href="tel:07981883340">07981883340</a></span>
	</div>

<div>
	<span>Email:</span>
	<span><a href="mailto:caledoniacontainers@msn.com">caledoniacontainers@msn.com</a></span>
</div>
</div>

<div>
	<iframe
		title="Map showing Caledonia Containers, 3 Irvine Road, Lugton Bridge, Lugton, Ayrshire KA3 4ED"
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		width="100%"
		height="300"
		src="https://maps.google.com/maps?width=300&amp;height=300&amp;hl=en&amp;q=3%20Irvine%20Road,%20Lugton%20Bridge,%20Lugton,%20Ayrshire,%20KA3%204ED&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=B&amp;output=embed">
	</iframe>
</div>

<div class="flex flex-col gap-1">
	<strong>Caledonia Containers Ltd,</strong>
	<span>3 Irvine Road </span>
	<span>Lugton Bridge</span>
	<span>Lugton Ayrshire </span>
	<span>KA3 4ED</span>
</div>

</Layout>
