---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Capabilities from "@/components/Capabilities.astro";
import Process from "@/components/Process.astro";
import CtaBand from "@/components/CtaBand.astro";
import { breadcrumbList, type Crumb } from "@/lib/schema";

import headerImage from "@/assets/about-3.webp";
import enclosureImage from "@/assets/about-1.webp";
import fleetImage from "@/assets/about-2.webp";

const trail: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "About us", href: "/about/" },
];
---

<BaseLayout
  title="About Caledonia Containers | Skip Manufacturer in Ayrshire"
  description="Caledonia Containers manufactures, refurbishes and repairs skips and waste containers across Scotland, from builders’ skips to roll-on-off compactors."
  schema={[breadcrumbList(trail)]}
>
  <PageHeader
    trail={trail}
    eyebrow="About us"
    title="How did we get here?"
    lead="A dedicated manufacturing, repair and spare-parts operation for Scotland's waste and recycling industry."
    image={headerImage}
    imageAlt="A freshly painted red builders' skip in the yard"
  />

  <section class="py-20 sm:py-24" aria-labelledby="story-heading">
    <div class="wrap grid gap-14 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-20">
      <div class="prose max-w-none">
        <h2 id="story-heading">Filling a gap in the industry</h2>
        <p>
          Recognising how scarce service, manufacturing and spare-parts resources were within the
          Scottish waste and recycling industry, Caledonia Containers launched a dedicated division
          to meet those needs.
        </p>
        <p>
          Our experienced team is ready to manufacture, refurbish and repair every type of skip and
          waste container, from the smallest builders' skips to the largest roll-on roll-off
          compactors. Our inspection, servicing, fabrication and repair facilities keep your
          containers in first-class condition.
        </p>

        <h2>More than skips</h2>
        <p>
          Alongside our core services we offer steam cleaning, shot blasting, painting, logo
          application, custom graphics and spare-parts procurement.
        </p>

        <h2>Your fleet, inspected</h2>
        <p>
          We carry out thorough inspections of our customers' equipment and provide reports on its
          condition, safety and lifespan. We then suggest tailored solutions to keep your fleet of
          containers in top condition and ready for immediate use.
        </p>
        <p>
          In today's cost-conscious, competitive market — with waste disposal costs on the rise — it
          is crucial that your containers project a professional image and keep pace with evolving
          regulations on visibility, containment, load restraint and transport.
        </p>
      </div>

      <div class="space-y-6">
        <Image
          src={enclosureImage}
          alt="A large container finished in black with high-visibility chevrons, ready for the customer"
          widths={[400, 640, 840]}
          sizes="(min-width: 1024px) 416px, 100vw"
          class="aspect-[3/4] w-full rounded-lg object-cover"
        />
        <Image
          src={fleetImage}
          alt="A red roll-on roll-off container finished in the customer's livery"
          widths={[400, 640]}
          sizes="(min-width: 1024px) 416px, 100vw"
          class="aspect-[4/3] w-full rounded-lg object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Ambition -->
  <section class="bg-brand-500 py-16 text-white sm:py-20">
    <figure class="wrap max-w-4xl text-center">
      <blockquote class="font-display text-3xl leading-tight font-bold tracking-tight uppercase sm:text-5xl">
        “Our aim is to be Scotland's premier skip manufacturer and container repair facility.”
      </blockquote>
      <figcaption class="mt-6 text-lg text-white/85">
        Committed to exceptional service and support for every customer.
      </figcaption>
    </figure>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="offer-heading">
    <div class="wrap">
      <SectionHeading id="offer-heading" eyebrow="What we offer" title="One workshop, every job" />
      <div class="mt-12">
        <Capabilities columns={4} />
      </div>
    </div>
  </section>

  <Process />
  <CtaBand title="Talk to us about your fleet" />
</BaseLayout>
