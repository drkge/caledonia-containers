---
import { type CollectionEntry, getCollection } from "astro:content";
import ServicePost from "@/layouts/ServicePost.astro";
import { render } from "astro:content";
import { SITE_URL, BUSINESS } from "@/consts";

export async function getStaticPaths() {
  const posts = await getCollection("service");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

export const prerender = true;

type Props = CollectionEntry<"service">;

const post = Astro.props;
const { Content } = await render(post);

const service = {
  "@type": "Service",
  name: post.data.title,
  description: post.data.description,
  serviceType: post.data.title,
  url: new URL(Astro.url.pathname, Astro.site).href,
  provider: { "@id": `${SITE_URL}/#organization` },
  areaServed: BUSINESS.areaServed.map((name) => ({
    "@type": "AdministrativeArea",
    name,
  })),
};
---

<ServicePost
  {...post.data}
  seoDescription={post.data.description}
  schema={[service]}
>
  <Content />
</ServicePost>
