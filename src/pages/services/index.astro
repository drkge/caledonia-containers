---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatIDo from "@/components/WhatIDo.astro";
import { SITE_URL } from "../../consts";

const title = "Our Services";
const description =
  "Skip manufacturing, wheelie bins, roll-on roll-off skips, part exchange, refurbishment and sheeting systems from Caledonia Containers, Ayrshire.";

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: "Our Services",
      item: `${SITE_URL}/services/`,
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead
      title={title}
      description={description}
      schema={[breadcrumbs]}
    />
  </head>
  <body>
    <Header />
    <main class="container mx-auto md:px-10 py-20">
      <WhatIDo headingLevel="h1" />
    </main>
    <Footer />
  </body>
</html>
